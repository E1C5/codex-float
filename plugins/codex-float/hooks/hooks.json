            "commandWindows": "python \"${PLUGIN_ROOT}/runtime/hook.py\"",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${PLUGIN_ROOT}/runtime/hook.py\"",
            "commandWindows": "python \"${PLUGIN_ROOT}/runtime/hook.py\"",
            "timeout": 3
          }
        ]
